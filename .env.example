# Server
PORT=3000
NODE_ENV=production

# Where the SQLite database lives
DATA_DIR=./data

# Signs session tokens. If left blank, one is generated on first boot and stored
# in <DATA_DIR>/.jwt-secret. Set it explicitly for long-lived installs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to 1 when serving over HTTPS (required for secure cookies + service worker on remote hosts)
SECURE_COOKIES=0

# Web push (optional but needed for mobile notifications).
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional third party metadata source (https://isbndb.com)
ISBNDB_API_KEY=

# Optional. The anonymous Google Books quota is shared and often exhausted;
# a free API key from Google Cloud gives you a reliable second source.
GOOGLE_BOOKS_API_KEY=

# Set to 0 to disable open registration once your users have accounts
ALLOW_REGISTRATION=1
